# Copy this file to `.env` and fill in your values.
# Never commit `.env` — it is listed in `.gitignore`.

# --- API keys (set the key for your chosen LLM_PROVIDER) ---
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
ACADEMIC_CLOUD_API_KEY=your_academic_cloud_api_key_here

# --- CARLA connection ---
CARLA_HOST=127.0.0.1
CARLA_PORT=2000
# Synchronous-mode fixed time step. The world advances only on client ticks,
# so a slow LLM decision does not cause uncontrolled motion between steps.
CARLA_FIXED_DELTA_S=0.05

# --- LLM provider ---
# groq | cerebras | ollama | ollama-remote | academic_cloud
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.2
# Optional global model override (wins over provider-specific model vars):
# LLM_MODEL=

# Model per provider (used when LLM_MODEL is unset):
GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_MODEL=llama3.1-8b
OLLAMA_MODEL=llama3
OLLAMA_REMOTE_MODEL=llama3.1:8b
ACADEMIC_CLOUD_MODEL=gpt-oss-120b

# Ollama endpoints (OpenAI-compatible /v1 API):
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_REMOTE_BASE_URL=http://your-remote-host:11434/v1

# KI:connect (https://chat.kiconnect.nrw/app — API Keys Management)
ACADEMIC_CLOUD_BASE_URL=https://chat.kiconnect.nrw/api/v1

# Optional timeouts (seconds)
# LLM_TIMEOUT=20.0
# OLLAMA_TIMEOUT=120.0
# LLM_RATE_LIMIT_BACKOFF_S=6.0

# --- Logging ---
LOG_LEVEL=INFO
# LOG_FILE=logs/run_custom.txt

# --- Simulation step timing ---
# STEP_INTERVAL_S is the single knob for how long each agent action is committed:
#   - physics ticks per step (STEP_INTERVAL_S / CARLA_FIXED_DELTA_S)
#   - decision_window_s, follow_safe_distance_m, maneuver_horizon_m (maneuver policy)
#   - LLM prompts (decision window text)
# In synchronous mode wall-clock LLM latency does not advance the world.
AGENT_LATENCY_S=0.0
STEP_INTERVAL_S=4.0
NUM_STEPS=16
MAX_LLM_TOOL_ROUNDS=6

# Maneuver allowance: horizon = planning_speed * (latency + step) + margin, clamped
# to [MIN_MANEUVER_HORIZON_M, MAX_MANEUVER_TRIGGER_M].
MANEUVER_SAFETY_MARGIN_M=24.0
MAX_MANEUVER_TRIGGER_M=55.0
MIN_MANEUVER_HORIZON_M=20.0
MIN_PLANNING_SPEED_MPS=3.5
LANE_CHANGE_MIN_DIST_M=5.0
CLOSE_FOLLOW_MIN_DIST_M=12.0

# --- Perception ---
BLOCKING_VEHICLE_MAX_DIST_M=18.0
BLOCKING_VEHICLE_MAX_LATERAL_M=12.0
STUCK_SPEED_MPS=0.5

# --- Lane keeping / centering ---
LANE_LOOKAHEAD_M=10.0
LANE_LAT_GAIN=0.045
LANE_YAW_GAIN=0.016
LANE_CENTER_TOLERANCE_M=0.7
LANE_CENTER_YAW_TOLERANCE_DEG=2.0
LANE_CENTER_LAT_GAIN=0.045
LANE_CENTER_YAW_GAIN=0.028
LANE_CENTER_MIN_STEER=0.05
LANE_CENTER_CREEP_SPEED_MPS=1.2
LANE_CENTER_CREEP_MIN_LEAD_M=10.0
LANE_CENTER_YAW_WEIGHT_OFF_CENTER=0.35
MAX_STEER_LANE_CHANGE=0.55
MAX_STEER_FOLLOW=0.25

# Speed-scaled steering authority
MAX_STEER_LANE_CHANGE_FLOOR=0.12
MAX_STEER_LANE_CHANGE_SCALE=0.03
MAX_STEER_FOLLOW_FLOOR=0.03
MAX_STEER_FOLLOW_SCALE=0.012

# Keep-right lane discipline (lane_preference.py)
KEEP_RIGHT_ENABLED=1

# Direct lane-change steering (lane_change_controller.py)
LANE_CHANGE_LAT_GAIN=0.085
LANE_CHANGE_YAW_GAIN=0.022
LANE_CHANGE_MIN_STEER=0.08
LANE_CHANGE_YAW_WEIGHT_OFF_CENTER=0.12
LANE_CHANGE_STEER_FLOOR=0.35
LANE_CHANGE_LEAD_MARGIN_M=4.0

# Lane-change merge geometry (maneuver_planner.py)
LANE_CHANGE_DURATION_S=2.8
COMFORT_LATERAL_ACCEL_MPS2=1.5
MERGE_WINDOW_FRACTION=0.7
MIN_MERGE_DISTANCE_M=7.0
DEFAULT_LANE_WIDTH_M=3.5
MERGE_MIN_SPEED_MPS=3.0

# Anti-creep: minimum throttle while accelerating toward target speed
FOLLOW_ACCEL_MIN_THROTTLE=0.35

# Per-tick telemetry (full JSONL written next to the run log)
TELEMETRY_ENABLED=1
TELEMETRY_LOG_EVERY=16

# Junction steering
JUNCTION_OFF_PATH_TOLERANCE_M=0.5
JUNCTION_YAW_WEIGHT_OFF_CENTER=0.12
JUNCTION_MIN_STEER=0.08

# Pedestrian conflict detection
PED_LANE_HALF_WIDTH_M=2.5
PED_STOP_DISTANCE_M=8.0
PED_MIN_LATERAL_SPEED_MPS=0.35
PED_CONFLICT_MAX_LONGITUDINAL_M=70.0

# Benchmark harness
BENCHMARK_PAUSE_S=2.0
